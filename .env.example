# CareFlow AI — Environment Variables
# Copy this to .env and fill in your values.
# Never commit .env to version control.

# Groq API key (get from https://console.groq.com)
# NEVER put a real key in this example file — it is committed to git.
GROQ_API_KEY=gsk_your_key_here

# Model selection (verified in Phase 0 probe)
SLM_MODEL=openai/gpt-oss-20b
STT_MODEL=whisper-large-v3-turbo

# Provider selection: groq | precomputed | bhashini
STT_PROVIDER=groq

# Report OCR provider: auto | vision | tesseract | precomputed
# auto tries the vision model first, then local Tesseract.
OCR_PROVIDER=auto

# Groq multimodal vision model used to read report photos/PDFs.
# qwen/qwen3.8-27b is the current Groq vision model.
VISION_MODEL=qwen/qwen3.8-27b
VISION_TIMEOUT_S=60
VISION_MAX_IMAGE_DIM=1600

# Local OCR fallback. Add +hin for Hindi traineddata (eng+hin).
TESSERACT_LANG=eng

# Path to tesseract executable (Windows example shown)
# Leave blank to use system PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# AI mode: live | cached | auto
# live: always call Groq
# cached: use precomputed outputs (works offline, for demo)
# auto: try live, fall back to cached, then to UNCERTAIN fallback
CAREFLOW_AI_MODE=auto

# Salt for HMAC in audit log (generate a random string, e.g. openssl rand -hex 32)
AUDIT_SALT=change_me_to_a_random_secret_string
